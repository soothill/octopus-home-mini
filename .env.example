# Octopus Energy API Configuration
OCTOPUS_API_KEY=your_api_key_here
OCTOPUS_ACCOUNT_NUMBER=your_account_number_here

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_org_name
INFLUXDB_BUCKET=octopus_energy

# Slack Configuration (Optional - set SLACK_ENABLED=false to disable)
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Application Configuration
POLL_INTERVAL_SECONDS=300
CACHE_DIR=./cache
LOG_LEVEL=info

# Reliability Settings
CACHE_SYNC_TIMEOUT_SECONDS=600
MAX_BACKOFF_FACTOR=3
CACHE_RETENTION_DAYS=7

# Docker Compose bootstrap settings (required only for the bundled InfluxDB
# and Grafana services). Generate unique passwords and add them to .env;
# never commit them.
# INFLUXDB_INIT_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
# INFLUXDB_HOST_IP=10.10.150.200
